-- KSR_PLUGIN_ID: image_master_loader
-- KSR_VERSION: 1.0
-- Image Master v1.0 - Developers: Muhammad Ramzan Qadri and Claude
-- Pure ASCII file. Updates are kept in the app's private folder, never in the plugin folder.
SER_UPDATE_URL = "https://raw.githubusercontent.com/ramzanjunejosahib345-star/Smart-Echo-Recorder-/main/Image%20code"
SER_VERSION_URL = "https://raw.githubusercontent.com/ramzanjunejosahib345-star/Smart-Echo-Recorder-/main/Image%20virgin"
require "import"
import "java.io.*"
import "java.lang.Byte"
import "java.lang.reflect.Array"
import "java.util.zip.Inflater"
import "android.os.*"
local EMB_VER = "1.0"
local PAYLOAD = {
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
""
}
local function say(t) pcall(function() service.speak(t) end) end
local function later(ms, fn)
  if type(task) == "function" then task(ms, fn)
  else
    local h = Handler(Looper.getMainLooper())
    h.postDelayed(luajava.createProxy("java.lang.Runnable", {run = fn}), ms)
  end
end
local function cacheFile()
  local dir = nil
  pcall(function() dir = service.getFilesDir() end)
  if dir == nil then pcall(function() dir = service.getExternalFilesDir(nil) end) end
  if dir == nil then return nil end
  return tostring(dir.getAbsolutePath()) .. "/image_master_code.lua"
end
local function verParts(v)
  local t = {}
  for n in tostring(v or ""):gmatch("%d+") do t[#t + 1] = tonumber(n) end
  return t
end
local function isNewer(a, b)
  local x, y = verParts(a), verParts(b)
  for i = 1, math.max(#x, #y) do
    local p, q = x[i] or 0, y[i] or 0
    if p ~= q then return p > q end
  end
  return false
end
local function readAll(p)
  local ok, d = pcall(function()
    local f = io.open(p, "rb")
    if not f then return nil end
    local t = f:read("a")
    f:close()
    return t
  end)
  if ok then return d end
  return nil
end
local function inflateB64(b64)
  local data = luajava.bindClass("android.util.Base64").decode(b64, 0)
  local inf = Inflater()
  inf.setInput(data)
  local baos = ByteArrayOutputStream()
  local buf = Array.newInstance(Byte.TYPE, 65536)
  local guard = 0
  while not inf.finished() and guard < 8000 do
    local n = tonumber(inf.inflate(buf))
    if n > 0 then baos.write(buf, 0, n)
    elseif inf.needsInput() or inf.needsDictionary() then break end
    guard = guard + 1
  end
  pcall(function() inf["end"]() end)
  return tostring(baos.toString("UTF-8"))
end
local function embeddedCode()
  return inflateB64(table.concat(PAYLOAD))
end
function SER_EXTRACT(text)
  local ok, res = pcall(function()
    local parts = {}
    for line in tostring(text):gmatch("[^\r\n]+") do
      local b = line:match('^"([A-Za-z0-9+/=]+)",?$')
      if b then parts[#parts + 1] = b end
    end
    if #parts == 0 then return nil end
    return inflateB64(table.concat(parts))
  end)
  if ok then return res end
  return nil
end
-- Background update check: downloads quietly, applies the next time the plugin is run.
local function download(url, onResult)
  local H = Handler(Looper.getMainLooper())
  local T = luajava.newInstance("java.lang.Thread", luajava.createProxy("java.lang.Runnable", {run = function()
    local ok, res = pcall(function()
      local u = luajava.newInstance("java.net.URL", url .. "?t=" .. tostring(os.time()))
      local conn = u.openConnection()
      conn.setConnectTimeout(6000)
      conn.setReadTimeout(10000)
      pcall(function() conn.setRequestProperty("User-Agent", "Mozilla/5.0") end)
      local code = tonumber(conn.getResponseCode())
      if code ~= 200 then error("HTTP " .. tostring(code)) end
      local ins = conn.getInputStream()
      local bo = luajava.newInstance("java.io.ByteArrayOutputStream")
      local b = Array.newInstance(Byte.TYPE, 16384)
      local okr, er = pcall(function()
        while true do
          local n = tonumber(ins.read(b))
          if n == nil or n < 0 then break end
          bo.write(b, 0, n)
        end
      end)
      pcall(function() ins.close() end)
      if not okr then error(er) end
      return bo.toByteArray()
    end)
    H.post(luajava.createProxy("java.lang.Runnable", {run = function() pcall(function() onResult(ok, res) end) end}))
  end}))
  T.start()
end
local function toText(bytes)
  local t = ""
  pcall(function() t = tostring(luajava.newInstance("java.lang.String", bytes, "UTF-8")) end)
  return t
end
local function currentVersion()
  local cf = cacheFile()
  local cached = cf and readAll(cf)
  if cached and cached:find("KSR_PLUGIN_ID:%s*image_master%s") then
    local cv = cached:match("KSR_VERSION:%s*([%d%.]+)")
    if cv and isNewer(cv, EMB_VER) then return cv end
  end
  return EMB_VER
end
local function checkUpdate()
  if SER_VERSION_URL == "" or SER_UPDATE_URL == "" then return end
  local mine = currentVersion()
  download(SER_VERSION_URL, function(ok, res)
    if not ok then return end
    local ver = toText(res):match("(%d+[%d%.]*)")
    if not ver or not isNewer(ver, mine) then return end
    download(SER_UPDATE_URL, function(ok2, res2)
      if not ok2 then return end
      local text = toText(res2)
      if not text:find("KSR_PLUGIN_ID:%s*image_master_loader") then return end
      local lv = text:match("KSR_VERSION:%s*([%d%.]+)")
      if lv ~= ver then return end
      local inner = SER_EXTRACT(text)
      if not inner then return end
      local hv = inner:match("KSR_VERSION:%s*([%d%.]+)")
      if hv ~= ver or not inner:find("KSR_PLUGIN_ID:%s*image_master%s") then return end
      local fn = load(inner, "=image_master_new", "t", _ENV)
      if not fn then return end
      local cf = cacheFile()
      if not cf then return end
      local tmp = cf .. ".tmp"
      local o = io.open(tmp, "wb")
      if not o then return end
      local okw = pcall(function() o:write(inner) o:flush() end)
      pcall(function() o:close() end)
      if not okw then pcall(function() os.remove(tmp) end) return end
      pcall(function() os.remove(cf) end)
      if os.rename(tmp, cf) then
        say("Image Master update " .. ver .. " is ready. It will work the next time you run the plugin.")
      end
    end)
  end)
end
function SER_START()
  local cf = cacheFile()
  local cached = cf and readAll(cf)
  local started = false
  if cached and cached:find("KSR_PLUGIN_ID:%s*image_master%s") then
    local cv = cached:match("KSR_VERSION:%s*([%d%.]+)")
    if cv and not isNewer(cv, EMB_VER) then
      pcall(function() os.remove(cf) end)
    end
    if cv and isNewer(cv, EMB_VER) then
      local fn = load(cached, "=image_master_update", "t", _ENV)
      if fn then
        local ok, err = pcall(fn)
        if ok then started = true
        else
          say("Updated version could not start, using built-in version.")
          pcall(function() os.remove(cf) end)
        end
      end
    end
  end
  if not started then
    local ok, err = pcall(function()
      local fn, e = load(embeddedCode(), "=image_master", "t", _ENV)
      if not fn then error("load failed: " .. tostring(e)) end
      fn()
    end)
    if not ok then say("Plugin could not start. " .. tostring(err)) end
  end
  pcall(function() later(6000, function() pcall(checkUpdate) end) end)
end
SER_START()