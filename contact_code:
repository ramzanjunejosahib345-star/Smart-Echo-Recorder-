-- ---------------- create contact (through the phone Contacts app) ----------------
local function savedContactExists(name, number)
  loadContacts()
  local want = digitsOf(number)
  local tail = want:sub(-9)
  for _, c in ipairs(contacts) do
    local d = digitsOf(c.number)
    if tail ~= "" and d:sub(-#tail) == tail and (name == "" or string.lower(c.name) == string.lower(name)) then
      return true
    end
  end
  return false
end

