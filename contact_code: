-- ---------------- load contacts ----------------
local function loadContacts()
  local list = {}
  local seen = {}
  local ok, err = pcall(function()
    local res = service.getContentResolver()
    local cur
    local ok1 = pcall(function()
      cur = res.query(PhoneCls.CONTENT_URI, nil, nil, nil, "display_name COLLATE LOCALIZED ASC")
    end)
    if not ok1 or cur == nil then
      cur = res.query(PhoneCls.CONTENT_URI, nil, nil, nil, nil)
    end
    if cur == nil then error("no contact data") end
    local iId = cur.getColumnIndex("contact_id")
    local iName = cur.getColumnIndex("display_name")
    local iNum = cur.getColumnIndex("data1")
    local iSt = cur.getColumnIndex("starred")
    local guard = 0
    while cur.moveToNext() do
      guard = guard + 1
      if guard > 60000 then break end
      local id = cur.getLong(iId)
      local name = tostring(cur.getString(iName) or "")
      local num = tostring(cur.getString(iNum) or "")
      local st = false
      if iSt >= 0 then st = (cur.getInt(iSt) == 1) end
      if num ~= "" then
        local key = tostring(id) .. "|" .. digitsOf(num)
        if not seen[key] then
          seen[key] = true
          if name == "" then name = num end
          list[#list + 1] = {id = id, name = name, number = num, starred = st}
        end
      end
    end
    cur.close()
  end)
  if not ok then
    say("Could not read contacts. " .. tostring(err))
  end
  table.sort(list, function(a, b)
    local x, y = string.lower(a.name), string.lower(b.name)
    if x == y then return a.number < b.number end
    return x < y
  end)
  contacts = list
  return ok
end

-- ---------------- missed calls ----------------
local function loadLog(typ)
  local list = {}
  pcall(function()
    local res = service.getContentResolver()
    local cur = res.query(CallLogCalls.CONTENT_URI, nil, "type=" .. tostring(typ), nil, "date DESC")
    if cur == nil then return end
    local iNum = cur.getColumnIndex("number")
    local iName = cur.getColumnIndex("name")
    local iDate = cur.getColumnIndex("date")
    local iNew = cur.getColumnIndex("new")
    local n = 0
    while cur.moveToNext() do
      n = n + 1
      if n > 300 then break end
      local num = tostring(cur.getString(iNum) or "")
      local name = ""
      if iName >= 0 then name = tostring(cur.getString(iName) or "") end
      local ms = 0
      if iDate >= 0 then ms = cur.getLong(iDate) end
      local isNew = false
      if iNew >= 0 then isNew = (cur.getInt(iNew) == 1) end
      list[#list + 1] = {number = num, name = name, date = ms, isNew = isNew}
    end
    cur.close()
  end)
  return list
end

-- ---------------- calling ----------------
local function getSims()
  local sims = {}
  pcall(function()
    local tm = service.getSystemService("telecom")
    local accts = tm.getCallCapablePhoneAccounts()
    if accts == nil then return end
    for i = 0, accts.size() - 1 do
      local h = accts.get(i)
      local label = ""
      pcall(function() label = tostring(tm.getPhoneAccount(h).getLabel()) end)
      sims[#sims + 1] = {handle = h, label = label, id = tostring(h.getId()), slot = nil}
    end
  end)
  -- slot numbers from the subscription list
  pcall(function()
    local sm = service.getSystemService("telephony_subscription_service")
    local subs = sm.getActiveSubscriptionInfoList()
    if subs == nil then return end
    local info = {}
    for i = 0, subs.size() - 1 do
      local s = subs.get(i)
      info[#info + 1] = {
        subId = tostring(s.getSubscriptionId()),
        slot = s.getSimSlotIndex(),
        carrier = tostring(s.getCarrierName() or ""),
      }
    end
    for _, sim in ipairs(sims) do
      for _, f in ipairs(info) do
        if sim.id == f.subId then
          sim.slot = f.slot
          if sim.label == "" then sim.label = f.carrier end
        end
      end
    end
    if #sims == 0 then
      -- no handles, but we still know the SIM slots
      for _, f in ipairs(info) do
        sims[#sims + 1] = {handle = nil, label = f.carrier, id = f.subId, slot = f.slot}
      end
    end
  end)
  for i, sim in ipairs(sims) do
    if sim.slot == nil then sim.slot = i - 1 end
  end
  table.sort(sims, function(a, b) return a.slot < b.slot end)
  return sims
end

local function dialOnly(number)
  local ok = pcall(function()
    local it = Intent(Intent.ACTION_DIAL, Uri.fromParts("tel", number, nil))
    it.addFlags(268435456)
    service.startActivity(it)
  end)
  return ok
end

local function placeCall(number, sim)
  number = tostring(number or "")
  if digitsOf(number) == "" then
    say("This number is empty")
    return
  end
  if not hasPerm("android.permission.CALL_PHONE") then
    if dialOnly(number) then
      say("Call permission is not allowed, so the phone dialer opened with this number. Press the call button there.")
    else
      say("Could not start the call. Please allow Phone permission for the screen reader app.")
    end
    return
  end
  local ok, err = pcall(function()
    local it = Intent(Intent.ACTION_CALL, Uri.fromParts("tel", number, nil))
    it.addFlags(268435456)
    if sim then
      if sim.handle ~= nil then
        pcall(function() it.putExtra("android.telecom.extra.PHONE_ACCOUNT_HANDLE", sim.handle) end)
      end
      local slot = sim.slot or 0
      pcall(function() it.putExtra("com.android.phone.force.slot", true) end)
      local keys = {"com.android.phone.extra.slot", "slot", "simSlot", "slot_id", "simslot", "sim_slot", "subscription_slot"}
      for _, k in ipairs(keys) do
        pcall(function() it.putExtra(k, IntegerCls.valueOf(slot)) end)
      end
      pcall(function() it.putExtra("Cdma_Supp", true) end)
    end
    service.startActivity(it)
  end)
  if ok then
    if sim then
      say("Calling with SIM " .. tostring((sim.slot or 0) + 1))
    else
      say("Calling")
    end
  else
    if dialOnly(number) then
      say("The call could not start directly, so the phone dialer opened with this number. Press the call button there.")
    else
      say("Could not start the call. " .. tostring(err))
    end
  end
end

