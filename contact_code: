      return
    end
    local root = nil
    pcall(function() root = service.getRootInActiveWindow() end)
    if root == nil then later(700, step) return end
    local pkg = ""
    pcall(function() pkg = string.lower(tostring(root.getPackageName() or "")) end)
    if not (pkg:find("contact") or pkg:find("dialer") or pkg:find("phone")) then
      later(700, step)
      return
    end
    local saveSet = {["save"] = true, ["done"] = true, ["ok"] = true, ["confirm"] = true, ["save contact"] = true}
    for _, word in ipairs({"save", "done", "ok", "confirm"}) do
      for _, n in ipairs(findByText(root, word)) do
        if saveSet[nodeText(n)] then
          if clickNode(n) then
            clicked = clicked + 1
            later(2200, function()
              if savedContactExists(name, number) then
                restartMain()
                later(900, function() say(name .. " saved") end)
              else
                step()
              end
            end)
            return
          end
        end
      end
    end
    -- some phones ask where to save the contact
    local whereSet = {["phone"] = true, ["device"] = true, ["on device"] = true, ["phone only"] = true, ["local"] = true}
    if clicked == 0 and tries > 4 then
      for _, word in ipairs({"phone", "device", "local"}) do
        for _, n in ipairs(findByText(root, word)) do
          if whereSet[nodeText(n)] and nodeIsButton(n) then
            if clickNode(n) then later(1200, step) return end
          end
        end
      end
    end
    later(800, step)
  end
  later(2200, step)
end

