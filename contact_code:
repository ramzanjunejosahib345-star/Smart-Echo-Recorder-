-- direct delete (works only when the screen reader app has permission to change contacts)
local function deleteDirect(c)
  local res = service.getContentResolver()
  pcall(function() res.delete(ContentUris.withAppendedId(Contacts.CONTENT_URI, c.id), nil, nil) end)
  if not contactExists(c.id) then return true end
  pcall(function()
    local Raw = bind("android.provider.ContactsContract$RawContacts")
    res.delete(Raw.CONTENT_URI, "contact_id=" .. tostring(c.id), nil)
  end)
  return not contactExists(c.id)
end

