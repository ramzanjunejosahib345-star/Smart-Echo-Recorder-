-- ---------------- list building ----------------
local function matches(c, q, qd)
  if q == "" then return true end
  -- only digits typed: search in the number
  if qd ~= "" and #qd == #q:gsub("[%s%+%-]", "") then
    return string.find(digitsOf(c.number), qd, 1, true) ~= nil
  end
  -- letters typed: the NAME must start with these letters
  local nm = string.lower(c.name)
  return string.sub(nm, 1, #q) == q
end

