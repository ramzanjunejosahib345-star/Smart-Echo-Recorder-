local function later(ms, fn)
  pcall(function()
    local h = Handler(Looper.getMainLooper())
    h.postDelayed(luajava.createProxy("java.lang.Runnable", {run = function() pcall(fn) end}), ms)
  end)
end

local function safe(fn)
  return function(...)
    local args = {...}
    local ok, err = pcall(function() fn(table.unpack(args)) end)
    if not ok then
      say("An error occurred. " .. tostring(err))
    end
  end
end

