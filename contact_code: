local function nodeText(n)
  local t = ""
  pcall(function() t = tostring(n.getText() or "") end)
  if t == "" then pcall(function() t = tostring(n.getContentDescription() or "") end) end
  return string.lower((t:gsub("^%s+", ""):gsub("%s+$", "")))
end

local function nodeIsButton(n)
  local cn = ""
  pcall(function() cn = tostring(n.getClassName() or "") end)
  return cn:find("Button") ~= nil
end

local function findByText(root, text)
  local out = {}
  pcall(function()
    local l = root.findAccessibilityNodeInfosByText(text)
    if l ~= nil then
      for i = 0, l.size() - 1 do out[#out + 1] = l.get(i) end
    end
  end)
  return out
end

local function clickNode(n)
  local cur = n
  for i = 1, 6 do
    if cur == nil then break end
    local okc = false
    pcall(function()
      if cur.isClickable() then okc = cur.performAction(16) end
    end)
    if okc then return true end
    local p = nil
    pcall(function() p = cur.getParent() end)
    cur = p
  end
  return false
end

local restartMain
local start

local function autoDeleteViaContactsApp(c)
  -- the plugin window must go away, otherwise it hides the Contacts app from the screen reader
  pcall(function() mainDialog.dismiss() end)
  say("Deleting " .. c.name .. " with the phone Contacts app. Please wait")
  local opened = false
  pcall(function()
    local it = Intent(Intent.ACTION_DELETE, ContentUris.withAppendedId(Contacts.CONTENT_URI, c.id))
    it.addFlags(268435456)
    if service.getPackageManager().resolveActivity(it, 0) ~= nil then
      service.startActivity(it)
      opened = true
    end
  end)
  if not opened then
    opened = pcall(function()
      local it = Intent(Intent.ACTION_VIEW, ContentUris.withAppendedId(Contacts.CONTENT_URI, c.id))
      it.addFlags(268435456)
      service.startActivity(it)
    end)
  end
  if not opened then
    restartMain()
    later(800, function() say("Could not open the Contacts app") end)
    return
  end
  local tries = 0
  local overflowAt = -10
  local overflowCount = 0
  local clicked = 0
  local step
  local function success()
    pcall(function() prefs.edit().remove("f" .. tostring(c.id)).commit() end)
    restartMain()
    later(900, function() say(c.name .. " deleted") end)
  end
  step = function()
    tries = tries + 1
    if not contactExists(c.id) then success() return end
    if tries > 26 then
      say("The delete could not finish by itself. The contact is open in the Contacts app. Open its menu and choose delete. To come back, open Phone Contact Manager again.")
      return
    end
    local root = nil
    pcall(function() root = service.getRootInActiveWindow() end)
    if root == nil then later(700, step) return end
    local pkg = ""
    pcall(function() pkg = string.lower(tostring(root.getPackageName() or "")) end)
    if not (pkg:find("contact") or pkg:find("dialer") or pkg:find("phone")) then
      later(700, step)
      return
    end
    -- 1. a confirm button in a dialog
    local confirmSet = {["delete"] = true, ["delete contact"] = true, ["ok"] = true, ["yes"] = true, ["remove"] = true, ["delete contacts"] = true}
    for _, word in ipairs({"delete", "ok", "yes", "remove"}) do
      for _, n in ipairs(findByText(root, word)) do
        if nodeIsButton(n) and confirmSet[nodeText(n)] then
          if clickNode(n) then
            clicked = clicked + 1
            later(1600, step)
            return
          end
        end
      end
    end
    -- 2. the delete item of the menu (or a delete button on the screen)
    local menuSet = {["delete"] = true, ["delete contact"] = true, ["delete contacts"] = true, ["remove contact"] = true, ["delete this contact"] = true}
    for _, word in ipairs({"delete", "remove"}) do
      for _, n in ipairs(findByText(root, word)) do
        if menuSet[nodeText(n)] and not nodeIsButton(n) then
          if clickNode(n) then
            later(1400, step)
            return
          end
        end
      end
    end
    -- 3. open the three-dots menu
    if overflowCount < 4 and tries - overflowAt >= 3 then
      local names = {"more options", "more", "options", "more actions", "menu"}
      for _, word in ipairs(names) do
        for _, n in ipairs(findByText(root, word)) do
          local t = nodeText(n)
          for _, nm in ipairs(names) do
            if t == nm then
              if clickNode(n) then
                overflowAt = tries
                overflowCount = overflowCount + 1
                later(1100, step)
                return
              end
            end
          end
        end
      end
    end
    later(800, step)
  end
  later(2200, step)
end

