    setInfo(tostring(#shown) .. " " .. what)
  elseif tab == 3 or tab == 5 then
    local list = loadLog(tab == 3 and 3 or 2)
    for _, m in ipairs(list) do
      shown[#shown + 1] = m
      local who = m.name ~= "" and m.name or (m.number ~= "" and m.number or "Unknown number")
