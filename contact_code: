local function playTuneThen(go)
  local started = false
  local introPlayer = nil
  local function lat(t, fn)
    pcall(function()
      local h = Handler(Looper.getMainLooper())
      h.postDelayed(luajava.createProxy("java.lang.Runnable", {run = fn}), t)
    end)
  end
  local function runGo()
    if started then return end
    started = true
    if introPlayer then
      pcall(function() introPlayer.stop() end)
      pcall(function() introPlayer.release() end)
      introPlayer = nil
    end
    local ok, e = pcall(go)
    if not ok then say("Plugin could not start. " .. tostring(e)) end
  end
  local function startTune(path, mode)
    local mp = MediaPlayer()
    introPlayer = mp
    mp.setDataSource(path)
    if mode == 2 then
      pcall(function()
        local ab = luajava.bindClass("android.media.AudioAttributes$Builder")()
        ab.setUsage(1)
        ab.setContentType(2)
        mp.setAudioAttributes(ab.build())
      end)
    end
    mp.prepare()
    mp.setOnCompletionListener(luajava.createProxy("android.media.MediaPlayer$OnCompletionListener", {
      onCompletion = function(m) lat(1, runGo) end
    }))
    mp.setOnErrorListener(luajava.createProxy("android.media.MediaPlayer$OnErrorListener", {
      onError = function(m, w, x) runGo() return true end
    }))
    mp.start()
    return mp
  end
  local function playIntro()
    local path = tostring(service.getCacheDir().getAbsolutePath()) .. "/intro_tune_pcm1.m4a"
    local data = luajava.bindClass("android.util.Base64").decode(table.concat(INTRO_B64), 0)
    local need = luajava.bindClass("java.lang.reflect.Array").getLength(data)
    local have = 0
    local fh = io.open(path, "rb")
    if fh then have = fh:seek("end") or 0 fh:close() end
    if have ~= need then
      local fo = luajava.newInstance("java.io.FileOutputStream", path)
      fo.write(data, 0, need)
      fo.flush()
      fo.close()
    end
    local mp
    local ok = pcall(function() mp = startTune(path, 1) end)
    if not ok then
      pcall(function() if introPlayer then introPlayer.release() end end)
      introPlayer = nil
      mp = startTune(path, 2)
    end
    local dur = 13000
    pcall(function()
      local d = mp.getDuration()
      if d and d > 0 then dur = d end
    end)
    -- if the tune is not really moving after 1.5 seconds, open the plugin now
    lat(1500, function()
      if started or not introPlayer then return end
      local playing, pos = false, 0
      pcall(function() playing = introPlayer.isPlaying() end)
      pcall(function() pos = tonumber(introPlayer.getCurrentPosition()) or 0 end)
      if not playing or pos < 100 then runGo() end
    end)
    lat(dur + 3000, runGo)
  end
  if not pcall(playIntro) then runGo() end
end

